# OpenAI BYOK
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5-mini
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=30000

# Zalo
ZALO_LOGIN_MODE=cookie
ZALO_COOKIE_PATH=./data/zalo/cookies.json
ZALO_IMEI=
ZALO_USER_AGENT=
ZALO_ALLOWED_GROUP_IDS=
ZALO_REPLY_ONLY_WHEN_MENTIONED=true
ZALO_DEBUG_MESSAGE=false
ZALO_AUTO_START_LISTENER=true

# Typing indicator while AI processes
ZALO_TYPING_ENABLED=true
ZALO_TYPING_DELAY_MS=300
ZALO_TYPING_INTERVAL_MS=5000
ZALO_TYPING_MAX_MS=60000
ZALO_TYPING_LOG=false

# AI
AI_ACTION_MODE=true
AI_MAX_OUTPUT_TOKENS=800

# Optional: OpenRouter (không xóa nếu đã dùng)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Conversation Storage (Phase 2A)
CONVERSATION_STORAGE_ENABLED=true
CONVERSATION_STORAGE_DIR=./data/conversations
CONVERSATION_STORE_RAW=false
CONVERSATION_RECENT_LIMIT=30
CONVERSATION_SAVE_NON_WHITELIST=false
CONVERSATION_RETENTION_DAYS=30

# Prompt system
PROMPT_USE_FILES=true
PROMPT_SPLIT_SYSTEM=true
PROMPT_CACHE_ENABLED=true
PROMPT_DEBUG=false
PROMPT_DEBUG_FULL=false
PROMPT_MAX_SYSTEM_CHARS=24000
PROMPT_MAX_RUNTIME_CHARS=2000

# User prompt key = Zalo senderId (người gửi), NOT group threadId.
# Group prompt key = Zalo group threadId (groups.json).
PROMPT_USER_ENABLED=true

# Prompt admin (/prompt debug)
PROMPT_ADMIN_ENABLED=true
ZALO_ADMIN_USER_IDS=9055859889841854657

# Tool system (Phase 2+)
TOOL_REGISTRY_ENABLED=true

# MySQL readonly tool (Phase 4) — OFF by default
MYSQL_TOOL_ENABLED=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=readonly_user
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_QUERY_TIMEOUT_MS=8000
MYSQL_MAX_ROWS=100
MYSQL_AUDIT_LOG=true
MYSQL_AUDIT_DIR=data/audit

# MySQL tool rate limit (Phase: Production Readiness)
# Per-thread+per-user+per-tool sliding window.
MYSQL_TOOL_RATE_LIMIT_PER_MINUTE=10
MYSQL_TOOL_RATE_LIMIT_PER_HOUR=100